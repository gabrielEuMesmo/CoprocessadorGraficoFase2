	NODE
	{
		REPEAT = 1;
		LEVEL 0 FOR 90.0;
		LEVEL 1 FOR 50.0;
		LEVEL 0 FOR 410.0;
		LEVEL 1 FOR 70.0;
		LEVEL 0 FOR 380.0;
	}
}

